{
  "expo": {
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ]
    ]
  },
  "cli": {
    "version": ">= 16.2.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://oralcare.fly.dev",
        "EXPO_PUBLIC_LOGIN_ENDPOINT": "/api/auth/login",
        "EXPO_PUBLIC_REGISTER_ENDPOINT": "/api/auth/register"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://oralcare.fly.dev",
        "EXPO_PUBLIC_LOGIN_ENDPOINT": "/api/auth/login",
        "EXPO_PUBLIC_REGISTER_ENDPOINT": "/api/auth/register"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
